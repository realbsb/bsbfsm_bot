FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml ./
RUN pip install --upgrade pip && pip install .

COPY workflow ./workflow
COPY locales ./locales

EXPOSE 8080

CMD ["uvicorn", "workflow.webapp.main:app", "--host", "0.0.0.0", "--port", "8080"]