# ============================================================
# Workflow — переменные окружения
# ============================================================

# --- Общее ---
APP_ENV=production
LOG_LEVEL=INFO
LOG_JSON=true
TZ=Europe/Moscow

# --- База данных (MariaDB нативно на Orange Pi через NCP) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=workflow
DB_PASSWORD=change_me
DB_NAME=workflow
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis (на 192.168.0.1) ---
REDIS_HOST=192.168.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# --- Telegram ---
BOT_TOKEN=123456:change_me
BOT_ADMIN_IDS=11111111,22222222

# --- WebApp ---
BOT_WEBAPP_BASE_URL=https://workflow.realbsb.ru
WEBAPP_ROOT_PATH=
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
WEBAPP_INITDATA_MAX_AGE=3600

# --- CSRF ---
WEBAPP_SECRET=change_me_long_random_string
WEBAPP_RATE_LIMIT_PER_MINUTE=20

# --- Прокси для api.telegram.org ---
TELEGRAM_PROXY=http://192.168.0.1:1080

# --- Whisper ---
WHISPER_CONTAINER=whisper
WHISPER_MODEL=small
WHISPER_TIMEOUT=120
WHISPER_WORK_DIR=/home/orangepi/telegram/shared/whisper-work

# --- LLM ---
LLM_ENABLED=false
LLM_BASE_URL=http://llm.local:8080
LLM_TIMEOUT=2.0
LLM_MODEL=qwen2.5:7b

# --- Radicale (опционально, каждый сотрудник вводит свои креды в профиле) ---
RADICALE_DEFAULT_URL=http://192.168.0.150:5232

# --- Google Calendar ---
# Штатные ссылки, OAuth не нужен.
# Переменные GOOGLE_CLIENT_ID/SECRET/URI не нужны.

# --- Пути ---
EXPORT_DIR=/var/lib/workflow/exports
ARCHIVE_DIR=/var/lib/workflow/archive
MEDIA_CACHE_DIR=/var/lib/workflow/media

# --- QR ---
QR_TOKEN_TTL_DAYS=14